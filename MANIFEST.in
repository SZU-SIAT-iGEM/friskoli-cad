include README.md CONTRIBUTING.md LICENSE THIRD_PARTY_NOTICES.md run.cmd start.ps1
include package.json package-lock.json
recursive-include docs *.md
recursive-include research *.py
recursive-include tools *.py
recursive-include .github *.yml *.md
include .gitlab-ci.yml
recursive-include examples *.py *.json *.md
recursive-include src/friskoli_cad/web *
recursive-include tests *.py *.mjs *.json
prune archive
prune runs
prune build
prune dist
prune node_modules
global-exclude __pycache__ *.py[cod] *.log
