    "/api/runs/preflight": {
      "post": {
        "summary": "Validate the exact submission without creating a task",
        "description": "Uses the same static validation and output budget rules as POST /api/runs. Accepts the full Submission including output_plan. No task, idempotency key or queue slot is reserved. Does not guarantee storage availability or runtime completion. Task submission repeats validation. Numerical inputs and output choices are never changed.",
