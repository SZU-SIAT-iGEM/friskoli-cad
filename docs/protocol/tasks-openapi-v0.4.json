                }
              }
            }
          },
          "410": {
            "description": "Retained resource or event cursor has expired; no automatic resubmission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "Task service or durable storage is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{id}/cancel": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        }
      ],
      "post": {
        "operationId": "cancelRun",
        "description": "Idempotent cancellation. Queued runs transition immediately; running runs set cancel_requested until a committed step boundary. First durable terminal transition wins. Repeat requests on a terminal task return that unchanged task.",
        "x-implementation-status": "implemented",
        "responses": {
          "200": {
            "description": "Terminal task, including immediate queued cancellation.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Task"
                    },
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.2.schema.json#/$defs/Task"
                    },
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.3.schema.json#/$defs/Task"
                    },
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.4.schema.json#/$defs/Task"
                    }
                  ]
                }
              }
            }
          },
          "202": {
            "description": "Running task with cancel_requested=true; poll for terminal outcome.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Task"
                    },
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.2.schema.json#/$defs/Task"
                    },
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.3.schema.json#/$defs/Task"
                    },
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.4.schema.json#/$defs/Task"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Malformed request or cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run or unpublished chunk.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "410": {
            "description": "Retained resource or event cursor has expired; no automatic resubmission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "Task service or durable storage is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{id}/events": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        }
      ],
      "get": {
        "operationId": "getRunEvents",
        "description": "Return durable ordered events strictly after after. Deduplicate by (run_id, seq). Expired cursor (including zero after pruning) is 410; future cursor is 400.",
        "x-implementation-status": "implemented",
        "responses": {
          "200": {
            "description": "Bounded page; next_after is last returned seq or unchanged input cursor for an empty page.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/EventPage"
                    },
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.2.schema.json#/$defs/EventPage"
                    },
