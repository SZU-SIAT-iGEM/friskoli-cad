  "components": {
    "schemas": {
      "CompiledPlan": {
        "anyOf": [
          {
            "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/CompiledPlan"
          },
          {
            "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.2.schema.json#/$defs/CompiledPlan"
