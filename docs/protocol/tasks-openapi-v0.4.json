{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Friskoli task API with explicit execution profiles",
    "version": "0.4.0",
    "description": "Legacy task 0.1, fixed PTS 0.2, unbiased spatial 0.3 and scientific chemotaxis 0.4 share endpoints with exact profile negotiation. Scientific frames carry metrics and preserve lifecycle events across stored-frame intervals. No service pause/resume."
  },
  "x-implementation-status": "implemented",
  "x-capabilities-extension": {
    "description": "Legacy capabilities remain in task; task_profiles explicitly describes all additional execution profiles with exact contract versions and immutable implementation locks.",
    "schema": {
      "anyOf": [
        {
          "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/TaskCapabilities"
        },
        {
          "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.2.schema.json#/$defs/TaskCapabilities"
        },
        {
          "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.3.schema.json#/$defs/TaskCapabilities"
        },
        {
          "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.4.schema.json#/$defs/TaskCapabilities"
        }
      ]
    }
  },
  "paths": {
    "/api/runs": {
      "post": {
        "operationId": "submitRun",
        "description": "Validate and estimate before admission. Atomically persist immutable input, task and idempotency record before 202. Same key and canonical content returns the original task (200), including terminal tasks. request_id is tracing only.",
        "x-implementation-status": "implemented",
        "responses": {
          "200": {
            "description": "Existing task reused without execution.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Task"
                    },
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.2.schema.json#/$defs/Task"
                    },
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.3.schema.json#/$defs/Task"
                    },
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.4.schema.json#/$defs/Task"
                    }
                  ]
                }
              }
            }
          },
          "202": {
            "description": "New durable queued task.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Task"
                    },
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.2.schema.json#/$defs/Task"
                    },
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.3.schema.json#/$defs/Task"
                    },
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.4.schema.json#/$defs/Task"
                    }
                  ]
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Run status resource.",
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON, duplicate members, missing headers or non-finite number.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "409": {
            "description": "Same retained idempotency key with different canonical content.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request, estimated memory or output exceeds published bounds; no task created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid project, unsupported contract/backend/semantics, unresolved lock or validation issues; no task created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "429": {
            "description": "Queue capacity reached; no task created. Retry-After gives seconds.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Minimum delay in seconds.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "503": {
            "description": "Durable admission unavailable; no runnable task acknowledged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "415": {
            "description": "Request Content-Type is not application/json; no task created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Submission"
                  },
                  {
                    "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.2.schema.json#/$defs/Submission"
                  },
                  {
                    "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.3.schema.json#/$defs/Submission"
                  },
                  {
                    "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.4.schema.json#/$defs/Submission"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/runs/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        }
      ],
      "get": {
        "operationId": "getRun",
        "description": "Read committed status after reconnect; this does not resume computation.",
        "x-implementation-status": "implemented",
        "responses": {
          "200": {
            "description": "Current durable task snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Task"
                    },
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.2.schema.json#/$defs/Task"
                    },
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.3.schema.json#/$defs/Task"
                    },
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.4.schema.json#/$defs/Task"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Malformed request or cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run or unpublished chunk.",
            "content": {
              "application/json": {
