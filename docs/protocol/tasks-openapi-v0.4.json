                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.3.schema.json#/$defs/EventPage"
                    },
                    {
                      "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.4.schema.json#/$defs/EventPage"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Malformed request or cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run or unpublished chunk.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "410": {
            "description": "Retained resource or event cursor has expired; no automatic resubmission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "Task service or durable storage is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../src/friskoli_cad/protocol/schemas/task-v0.1.schema.json#/$defs/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Defaults to published event_page_size; larger values are rejected with 400."
          }
        ]
      }
    },
