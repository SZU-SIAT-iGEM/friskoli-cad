{
  "protocol_version": "0.1.0",
  "id": "reservoir-uptake-example",
  "nodes": [
    {
      "id": "field",
      "module_id": "field.ideal_reservoir",
      "module_version": "1.0.0",
      "owner": {"kind": "environment", "id": "domain"},
      "parameters": {
        "species": {"value": "substrate", "provenance": {"kind": "example", "reference": "uptake-demo"}},
        "initial_concentration": {"value": 10, "unit": "uM", "provenance": {"kind": "example", "reference": "uptake-demo"}}
      }
    },
    {
      "id": "sampler",
      "module_id": "field.sample_nearest",
      "module_version": "1.0.0",
      "owner": {"kind": "population", "id": "group_1"},
      "parameters": {
        "species": {"value": "substrate", "provenance": {"kind": "example", "reference": "uptake-demo"}}
      }
    },
    {
      "id": "uptake",
      "module_id": "uptake.linear",
      "module_version": "1.0.0",
      "owner": {"kind": "population", "id": "group_1"},
      "parameters": {
        "species": {"value": "substrate", "provenance": {"kind": "example", "reference": "uptake-demo"}},
        "rate_constant": {"value": 100, "unit": "molecule/(s*uM)", "provenance": {"kind": "example", "reference": "illustrative, uncalibrated"}}
      }
    },
    {
      "id": "deposit",
      "module_id": "field.deposit_nearest",
      "module_version": "1.0.0",
      "owner": {"kind": "population", "id": "group_1"},
      "parameters": {
        "species": {"value": "substrate", "provenance": {"kind": "example", "reference": "uptake-demo"}}
      }
    }
  ],
  "edges": [
    {"id": "field_to_sampler", "from": {"node": "field", "port": "concentration"}, "to": {"node": "sampler", "port": "concentration"}, "timing": "same_step"},
    {"id": "sampler_to_uptake", "from": {"node": "sampler", "port": "local_concentration"}, "to": {"node": "uptake", "port": "local_concentration"}, "timing": "same_step"},
    {"id": "uptake_to_deposit", "from": {"node": "uptake", "port": "uptake_flux"}, "to": {"node": "deposit", "port": "uptake_flux"}, "timing": "same_step"},
    {"id": "deposit_to_field", "from": {"node": "deposit", "port": "consumption_rate"}, "to": {"node": "field", "port": "consumption_rate"}, "timing": "previous_step"}
  ]
}
