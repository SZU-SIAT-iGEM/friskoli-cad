{
  "protocol_version": "0.1.0",
  "id": "field.local_inventory",
  "version": "3.0.0",
  "scope": "environment",
  "phase": 3,
  "scientific_role": "mechanism",
  "maturity": "exploratory",
  "description": "Project-initialized species inventory with optional cell uptake and diffusion, plus a scheduled external rate and signed material ledger.",
  "inputs": {
    "consumption_rate": {"shape": "field.scalar", "quantity": "consumption_rate", "unit": "uM/s", "species_parameter": "species", "optional": true},
    "diffusion_rate": {"shape": "field.scalar", "quantity": "diffusion_rate", "unit": "uM/s", "species_parameter": "species", "optional": true},
    "external_rate": {"shape": "field.scalar", "quantity": "external_rate", "unit": "uM/s", "species_parameter": "species"}
  },
  "outputs": {
    "concentration": {"shape": "field.scalar", "quantity": "concentration", "unit": "uM", "species_parameter": "species"},
    "external_flux": {"shape": "field.scalar", "quantity": "external_flux", "unit": "molecule/s", "species_parameter": "species"},
    "cumulative_external": {"shape": "field.scalar", "quantity": "cumulative_external", "unit": "molecule", "species_parameter": "species"}
  },
  "parameters": {
    "species": {"type": "string"}
  },
  "state": {
    "concentration": {"shape": "field.scalar", "unit": "uM", "on_division": "not_applicable"},
    "cumulative_external": {"shape": "field.scalar", "unit": "molecule", "on_division": "not_applicable"}
  },
  "initial_outputs": ["concentration", "external_flux", "cumulative_external"]
}
