{
  "protocol_version": "0.1.0",
  "id": "field.ideal_reservoir",
  "version": "1.0.0",
  "scope": "environment",
  "phase": 3,
  "scientific_role": "closure",
  "maturity": "exploratory",
  "description": "An unlimited ideal reservoir exactly replaces local cell uptake and holds concentration fixed; no spatial transport.",
  "inputs": {
    "consumption_rate": {"shape": "field.scalar", "quantity": "consumption_rate", "unit": "uM/s", "species_parameter": "species"}
  },
  "outputs": {
    "concentration": {"shape": "field.scalar", "quantity": "concentration", "unit": "uM", "species_parameter": "species"},
    "supply_flux": {"shape": "field.scalar", "quantity": "supply_flux", "unit": "molecule/s", "species_parameter": "species"},
    "cumulative_supply": {"shape": "field.scalar", "quantity": "cumulative_supply", "unit": "molecule", "species_parameter": "species"}
  },
  "parameters": {
    "species": {"type": "string"},
    "initial_concentration": {"type": "number", "unit": "uM", "minimum": 0}
  },
  "state": {
    "cumulative_supply": {"shape": "field.scalar", "unit": "molecule", "on_division": "not_applicable"}
  },
  "initial_outputs": ["concentration", "supply_flux", "cumulative_supply"]
