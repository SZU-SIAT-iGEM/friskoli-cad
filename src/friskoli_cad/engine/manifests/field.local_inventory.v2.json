{
  "protocol_version": "0.1.0",
  "id": "field.local_inventory",
  "version": "2.0.0",
  "scope": "environment",
  "phase": 3,
  "scientific_role": "mechanism",
  "maturity": "exploratory",
  "description": "Local species inventory changes by declared diffusion and cell-consumption rates.",
  "inputs": {
    "consumption_rate": {"shape": "field.scalar", "quantity": "consumption_rate", "unit": "uM/s", "species_parameter": "species"},
    "diffusion_rate": {"shape": "field.scalar", "quantity": "diffusion_rate", "unit": "uM/s", "species_parameter": "species"}
  },
  "outputs": {
    "concentration": {"shape": "field.scalar", "quantity": "concentration", "unit": "uM", "species_parameter": "species"}
  },
  "parameters": {
    "species": {"type": "string"},
    "initial_concentration": {"type": "number", "unit": "uM", "minimum": 0}
  },
  "state": {
    "concentration": {"shape": "field.scalar", "unit": "uM", "on_division": "not_applicable"}
  },
  "initial_outputs": ["concentration"]
}
