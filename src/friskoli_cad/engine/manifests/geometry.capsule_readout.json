      "quantity": "capsule_diameter",
      "unit": "um"
    },
    "surface_area": {
      "shape": "cell.scalar",
      "quantity": "area",
      "unit": "um^2"
    },
    "volume": {
      "shape": "cell.scalar",
      "quantity": "volume",
      "unit": "um^3"
    }
  },
  "parameters": {},
  "state": {},
  "initial_outputs": [
    "position",
    "length",
    "diameter",
    "surface_area",
    "volume"
  ]
