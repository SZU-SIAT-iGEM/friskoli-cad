      ],
      "provenance": "source-derived",
      "mechanism_evidence": [],
      "specific_equation_calibration": "unknown"
    },
    {
      "id": "simplified_capacity",
      "expression": "N_target=N0*G; N_cap=N0*G_cap*A/A0; N_functional=min(N_target,N_cap)",
      "semantics": "B reference-area capacity, independent of A footprint assumption",
      "source_locations": [
