  "numerics": {
    "id": "endpoint-frozen-chea-exponential-v1",
    "expression": "e_new=e_old*exp(-beta_e*dt)+e_ss*(1-exp(-beta_e*dt)); A_new=A(e_new); Y_new=Y_old*exp(-beta_y*dt)+Y_ss(A_new)*(1-exp(-beta_y*dt))",
    "order": "EI exact for constant accepted flux; CheY frozen at endpoint CheA; full coupled scheme first order",
    "repairs": [
      "Reject invalid inputs instead of implicit clipping.",
      "Exact zero Hill response; stable scaled saturation and log Hill arithmetic.",
      "No epsilon forcing nonunique zero-rate steady state to zero; time advance freezes states when rates vanish."
    ],
