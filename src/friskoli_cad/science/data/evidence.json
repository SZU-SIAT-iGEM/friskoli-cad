    },
    {
      "id": "chey_rhs",
      "expression": "dY/dt=k_Y*A_active*(Y_total-Y)-k_Z*Y",
      "semantics": "CheY-P concentration uM; total protein concentration held fixed",
      "source_locations": [
        "rebuilt-v2/model/signaling.py:pts_step",
