    {
      "id": "rebuilt_capacity",
      "expression": "N_target=N0*G; N_cap=(1-f_basal)*A*f_pts/a_ascf; N_functional=min(N_target,N_cap)",
      "semantics": "A footprint capacity; all N are total expected copies per cell",
      "source_locations": [
