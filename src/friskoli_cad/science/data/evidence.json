      "specific_equation_calibration": "unknown"
    },
    {
      "id": "ei_rhs",
      "expression": "de/dt=k_d*J_accepted*(1-e)-k_r*e",
      "semantics": "e is dephosphorylated EI fraction; k_d molecule^-1",
