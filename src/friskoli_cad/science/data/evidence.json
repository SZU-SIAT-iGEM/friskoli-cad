    {
      "id": "constant_flux_steady",
      "expression": "e*=k_d*J/(k_d*J+k_r); Y*=Y_total*k_Y*A(e*)/(k_Y*A(e*)+k_Z)",
      "semantics": "Unique only for nonzero relaxation rates; no finite-reservoir equilibrium claim",
