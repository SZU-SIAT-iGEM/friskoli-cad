      "semantics": "Concentrations in uM; phenomenological inhibition, not full receptor network",
      "source_locations": [
        "rebuilt-v2/model/signaling.py:pts_step",
        "simplified-v4/core/batch.py:pts_step"
      ],
      "provenance": "source-derived",
