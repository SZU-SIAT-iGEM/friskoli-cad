{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:friskoli:protocol:run:0.1.0",
  "title": "Friskoli run metadata 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "run_id",
    "graph_id",
    "groups",
    "channels"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "graph_id": {
      "type": "string",
      "minLength": 1
    },
    "groups": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "channels": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node",
          "port",
          "group_id",
          "shape",
          "quantity",
          "unit"
        ],
        "properties": {
          "node": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "type": "string",
            "minLength": 1
          },
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "shape": {
            "enum": [
              "cell.scalar",
              "cell.index"
            ]
          },
          "quantity": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
