{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:friskoli:checkpoint-file:0.2.0",
  "title": "Self-contained chemotaxis checkpoint file",
  "description": "Frozen Project 0.5 and complete dynamic scientific state. Restoration additionally validates all locks, shapes and accounting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_file_version",
    "project",
    "checkpoint",
    "document_sha256"
  ],
  "properties": {
    "checkpoint_file_version": {
      "const": "0.2.0"
    },
    "project": {
      "type": "object",
      "required": [
        "project_version",
        "execution_profile"
      ],
      "properties": {
        "project_version": {
          "const": "0.5.0"
        },
        "execution_profile": {
          "const": "chemotaxis-spatial-v1"
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "version",
        "execution_profile",
        "payload_sha256"
      ],
      "properties": {
        "version": {
          "const": "chemotaxis-checkpoint/v1"
        },
        "execution_profile": {
          "const": "chemotaxis-spatial-v1"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "document_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
