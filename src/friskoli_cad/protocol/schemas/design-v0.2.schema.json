{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:friskoli:design:0.2.0",
  "title": "Friskoli candidate design 0.2.0",
  "type": "object",
  "required": [
    "design_version",
    "id",
    "brief",
    "baseline_project",
    "settings",
    "candidates",
    "excluded",
    "budget"
  ],
  "properties": {
    "design_version": {
      "const": "0.2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "brief": {
      "$ref": "urn:friskoli:design-brief:0.2.0"
    },
    "baseline_project": {
      "$ref": "urn:friskoli:project:0.6.0"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dt_s",
        "steps"
      ],
      "properties": {
        "dt_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "frame_every_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "include_fields": {
          "type": "boolean"
        },
        "backend": {
          "enum": [
            "numpy-cpu",
            "numpy-cupy-cuda"
          ]
        },
        "field_stride_xyz": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "include_final_fields": {
          "type": "boolean"
        }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "project",
          "overrides",
          "explanation",
          "soft_penalty"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "candidate",
              "control"
            ]
          },
          "project": {
            "$ref": "urn:friskoli:project:0.6.0"
          },
          "overrides": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "node_id",
                "parameter",
                "value"
              ],
              "properties": {
                "node_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "parameter": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "provenance": {
                  "type": "object"
                }
              }
            }
          },
          "explanation": {
            "type": "string"
          },
          "soft_penalty": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "reasons"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string"
          },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "candidate_count",
        "repeats",
        "total_runs",
        "total_steps"
      ],
      "properties": {
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "repeats": {
          "type": "integer",
          "minimum": 0
        },
        "total_runs": {
          "type": "integer",
          "minimum": 0
        },
        "total_steps": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
