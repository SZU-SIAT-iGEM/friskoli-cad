{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:friskoli:checkpoint-file:0.1.0",
  "title": "Self-contained spatial checkpoint file envelope",
  "description": "This schema validates the file envelope. The restore implementation additionally validates the complete Project 0.4 contract, checkpoint state, checksums and implementation locks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkpoint_file_version", "project", "checkpoint", "document_sha256"],
  "properties": {
    "checkpoint_file_version": {"const": "0.1.0"},
    "project": {
      "type": "object",
      "required": ["project_version", "execution_profile"],
      "properties": {
        "project_version": {"const": "0.4.0"},
        "execution_profile": {"const": "spatial-unbiased-v1"}
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["version", "execution_profile", "payload_sha256"],
      "properties": {
        "version": {"const": "spatial-checkpoint/v2"},
        "execution_profile": {"const": "spatial-unbiased-v1"},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
