{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:friskoli:protocol:graph:0.1.0",
  "title": "Friskoli behavior graph 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "id", "nodes", "edges"],
  "properties": {
    "protocol_version": {"const": "0.1.0"},
    "id": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "module_id", "module_version", "owner", "parameters"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "module_id": {"type": "string", "minLength": 1},
        "module_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": {"enum": ["environment", "source", "population"]},
            "id": {"type": "string", "minLength": 1}
          }
        },
        "parameters": {
          "type": "object",
          "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"$ref": "#/$defs/parameterValue"}
        }
      }
    },
    "parameterValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance"],
      "properties": {
        "value": {"type": ["number", "integer", "boolean", "string"]},
        "unit": {"type": "string", "minLength": 1},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference"],
          "properties": {
            "kind": {"enum": ["example", "user", "literature", "measurement", "calibration"]},
            "reference": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "port"],
      "properties": {
        "node": {"type": "string", "minLength": 1},
        "port": {"type": "string", "minLength": 1}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "timing"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "from": {"$ref": "#/$defs/endpoint"},
        "to": {"$ref": "#/$defs/endpoint"},
        "timing": {"enum": ["same_step", "previous_step"]}
      }
    }
  }
}
