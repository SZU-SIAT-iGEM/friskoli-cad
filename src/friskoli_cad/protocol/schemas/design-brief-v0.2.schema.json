{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:friskoli:design-brief:0.2.0",
  "title": "Friskoli DesignBrief 0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief_version",
    "id",
    "name",
    "goal",
    "chassis",
    "variables",
    "constraints",
    "seeds",
    "max_runs",
    "result_constraints",
    "selection_policy"
  ],
  "properties": {
    "brief_version": {
      "const": "0.2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "direction",
        "group_id"
      ],
      "properties": {
        "metric": {
          "enum": [
            "mean_displacement_um",
            "region_fraction",
            "ever_arrived_fraction",
            "mean_residence_s"
          ]
        },
        "direction": {
          "enum": [
            "maximize",
            "minimize"
          ]
        },
        "group_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "chassis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provenance"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "parameter",
          "values"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "parameter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "node_id",
          "parameter",
          "operator",
          "value"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "parameter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "hard",
              "soft"
            ]
          },
          "operator": {
            "enum": [
              "<=",
              ">="
            ]
          },
          "value": {
            "type": "number"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "max_runs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "result_constraints": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "metric",
          "group_id",
          "operator",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "hard",
              "soft"
            ]
          },
          "metric": {
            "enum": [
              "mean_displacement_um",
              "region_fraction",
              "ever_arrived_fraction",
              "mean_residence_s"
            ]
          },
          "group_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "operator": {
            "enum": [
              "<=",
              ">="
            ]
          },
          "value": {
            "type": "number"
          }
        }
      }
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_repeats",
        "min_control_improvement"
      ],
      "properties": {
        "min_repeats": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "min_control_improvement": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
