{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friskoli.invalid/schemas/task-v0.3.schema.json",
  "title": "Friskoli task contract 0.3.0: unbiased spatial profile",
  "description": "Spatial task profile with complete concentration fields and seeded motion; prior contracts remain unchanged.",
  "$ref": "#/$defs/Task",
  "$defs": {
    "Issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "phase",
        "path",
        "targets",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "phase": {
          "enum": [
            "request",
            "resolve",
            "validate",
            "estimate",
            "queue",
            "initialize",
            "execute",
            "publish",
            "recover"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Error": {
      "$ref": "task-v0.1.schema.json#/$defs/Error",
      "description": "Shared transport errors retain 0.1.0, including errors before a project/profile can be identified."
    },
    "Lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_sha256",
        "implementations"
      ],
      "properties": {
        "registry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "implementations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "Submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_contract_version",
        "request_id",
        "project",
        "version_lock",
        "execution",
        "output_plan",
        "edit_revision"
      ],
      "properties": {
        "task_contract_version": {
          "const": "0.3.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "project": {
          "$ref": "project-v0.4.schema.json"
        },
        "version_lock": {
          "$ref": "#/$defs/Lock"
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semantics",
            "backend",
            "dt_s",
            "steps",
            "seed"
          ],
          "properties": {
            "semantics": {
              "const": "spatial-unbiased-v1"
            },
            "backend": {
              "type": "string",
              "minLength": 1
            },
            "dt_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "steps": {
              "type": "integer",
              "minimum": 1
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "output_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frame_every_steps",
            "observables",
            "include_fields"
          ],
          "properties": {
            "frame_every_steps": {
              "type": "integer",
              "minimum": 1
            },
            "observables": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "include_fields": {
              "type": "boolean"
            }
          }
        },
        "edit_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_bytes",
        "cells",
        "voxels",
        "steps",
        "estimated_memory_bytes",
        "output_bytes",
        "queued_runs",
        "active_runs",
        "wall_time_s",
        "event_page_size",
        "chunk_bytes",
        "retention_seconds",
        "idempotency_retention_seconds"
      ],
      "properties": {
        "request_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "cells": {
          "type": "integer",
          "minimum": 1
        },
        "voxels": {
          "type": "integer",
          "minimum": 1
        },
        "steps": {
          "type": "integer",
          "minimum": 1
        },
        "estimated_memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "queued_runs": {
          "type": "integer",
          "minimum": 1
        },
        "active_runs": {
          "const": 1
        },
        "wall_time_s": {
          "type": "integer",
          "minimum": 1
        },
        "event_page_size": {
          "type": "integer",
          "minimum": 1
        },
        "chunk_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "retention_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "idempotency_retention_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells",
        "voxels",
        "steps",
        "memory_bytes",
        "output_bytes"
      ],
      "properties": {
        "cells": {
          "type": "integer",
          "minimum": 0
        },
        "voxels": {
          "type": "integer",
          "minimum": 0
        },
        "steps": {
          "type": "integer",
          "minimum": 1
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "TaskCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_contract_version",
        "mode",
        "pause",
        "resume",
        "checkpoint",
        "partial_results",
        "hash_canonicalization",
        "limits",
        "version_lock",
        "execution"
      ],
      "properties": {
        "task_contract_version": {
          "const": "0.3.0"
        },
        "mode": {
          "const": "single-worker"
        },
        "pause": {
          "const": false
        },
        "resume": {
          "const": false
        },
        "checkpoint": {
          "const": false
        },
        "partial_results": {
          "const": true
        },
        "hash_canonicalization": {
          "const": "RFC8785"
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "version_lock": {
          "$ref": "#/$defs/Lock"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionSupport"
        }
      }
    },
    "InputSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "href",
        "document_sha256",
        "scientific_sha256",
        "plan_sha256",
        "registry_sha256",
        "canonicalization",
        "edit_revision"
      ],
      "properties": {
        "href": {
          "type": "string",
          "pattern": "^/api/runs/[A-Za-z0-9_-]{1,128}/input$"
        },
        "document_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scientific_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "canonicalization": {
          "const": "RFC8785"
        },
        "edit_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "committed_step",
        "simulation_time_s"
      ],
      "properties": {
        "committed_step": {
          "type": "integer",
          "minimum": 0
        },
        "simulation_time_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_contract_version",
        "run_id",
        "status",
        "created_at",
        "updated_at",
        "finished_at",
        "cancel_requested",
        "input_snapshot",
        "estimate",
        "progress",
        "last_event_seq",
        "result",
        "issues"
      ],
      "properties": {
        "task_contract_version": {
          "const": "0.3.0"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "completed",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "cancel_requested": {
          "type": "boolean"
        },
        "input_snapshot": {
          "$ref": "#/$defs/InputSnapshot"
        },
        "estimate": {
          "$ref": "#/$defs/Estimate"
        },
        "progress": {
          "$ref": "#/$defs/Progress"
        },
        "last_event_seq": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "href",
            "completeness"
          ],
          "properties": {
            "href": {
              "type": "string",
              "pattern": "^/api/runs/[A-Za-z0-9_-]{1,128}/result$"
            },
            "completeness": {
              "enum": [
                "none",
                "partial",
                "complete"
              ]
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "queued",
                  "running"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "finished_at": {
                "type": "null"
              },
              "result": {
                "properties": {
                  "completeness": {
                    "enum": [
                      "none",
                      "partial"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "failed",
                  "cancelled",
                  "interrupted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "finished_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "completed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "properties": {
                  "completeness": {
                    "enum": [
                      "complete"
                    ]
                  }
                }
              },
              "issues": {
                "not": {
                  "contains": {
                    "properties": {
                      "severity": {
                        "const": "error"
                      }
                    },
                    "required": [
                      "severity"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "failed",
                  "cancelled",
                  "interrupted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "properties": {
                  "completeness": {
                    "enum": [
                      "none",
                      "partial"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "failed",
                  "interrupted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "issues": {
                "contains": {
                  "properties": {
                    "severity": {
                      "const": "error"
                    }
                  },
                  "required": [
                    "severity"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "cancelled"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "cancel_requested": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "queued"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "cancel_requested": {
                "const": false
              },
              "progress": {
                "properties": {
                  "committed_step": {
                    "const": 0
                  },
                  "simulation_time_s": {
                    "const": 0
                  }
                }
              },
              "result": {
                "properties": {
                  "completeness": {
                    "enum": [
                      "none"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "type",
        "created_at",
        "task"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "accepted",
            "started",
            "progress",
            "cancel_requested",
            "completed",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "task": {
          "$ref": "#/$defs/Task"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "task": {
                "properties": {
                  "status": {
                    "const": "queued"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "started"
              }
            }
          },
          "then": {
            "properties": {
              "task": {
                "properties": {
                  "status": {
                    "const": "running"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "progress"
              }
            }
          },
          "then": {
            "properties": {
              "task": {
                "properties": {
                  "status": {
                    "const": "running"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "task": {
                "properties": {
                  "status": {
                    "const": "completed"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "task": {
                "properties": {
                  "status": {
                    "const": "failed"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "task": {
                "properties": {
                  "status": {
                    "const": "cancelled"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "interrupted"
              }
            }
          },
          "then": {
            "properties": {
              "task": {
                "properties": {
                  "status": {
                    "const": "interrupted"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cancel_requested"
              }
            }
          },
          "then": {
            "properties": {
              "task": {
                "properties": {
                  "status": {
                    "const": "running"
                  },
                  "cancel_requested": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    },
    "EventPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "events",
        "next_after",
        "has_more",
        "latest_seq"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Event"
          }
        },
        "next_after": {
          "type": "integer",
          "minimum": 0
        },
        "has_more": {
          "type": "boolean"
        },
        "latest_seq": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "href",
        "sha256",
        "bytes",
        "media_type",
        "first_step",
        "last_step"
      ],
      "properties": {
        "chunk_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "href": {
          "type": "string",
          "pattern": "^/api/runs/[A-Za-z0-9_-]{1,128}/chunks/[A-Za-z0-9_-]{1,128}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "media_type": {
          "const": "application/json"
        },
        "first_step": {
          "type": "integer",
          "minimum": 0
        },
        "last_step": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_contract_version",
        "run_id",
        "status",
        "completeness",
        "input_snapshot",
        "progress",
        "chunks",
        "issues",
        "compiled_plan",
        "provenance"
      ],
      "properties": {
        "task_contract_version": {
          "const": "0.3.0"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "completeness": {
          "enum": [
            "partial",
            "complete"
          ]
        },
        "input_snapshot": {
          "$ref": "#/$defs/InputSnapshot"
        },
        "progress": {
          "$ref": "#/$defs/Progress"
        },
        "chunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Chunk"
          },
          "minItems": 1
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        },
        "compiled_plan": {
          "$ref": "#/$defs/CompiledPlan"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "completeness": {
                "const": "complete"
              }
            }
          },
          "else": {
            "properties": {
              "completeness": {
                "const": "partial"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "failed",
                  "interrupted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "issues": {
                "contains": {
                  "properties": {
                    "severity": {
                      "const": "error"
                    }
                  },
                  "required": [
                    "severity"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "issues": {
                "not": {
                  "contains": {
                    "properties": {
                      "severity": {
                        "const": "error"
                      }
                    },
                    "required": [
                      "severity"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ChunkBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_contract_version",
        "run_id",
        "chunk_id",
        "frames"
      ],
      "properties": {
        "task_contract_version": {
          "const": "0.3.0"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "chunk_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FrameEnvelope"
          },
          "minItems": 1
        }
      }
    },
    "ExecutionSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantics",
        "backend",
        "default_seed"
      ],
      "properties": {
        "semantics": {
          "const": "spatial-unbiased-v1"
        },
        "backend": {
          "const": "numpy-cpu"
        },
        "default_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "PlanParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "provenance_kind",
        "provenance_reference"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "boolean",
            "string"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "provenance_kind": {
          "enum": [
            "example",
            "user",
            "literature",
            "measurement",
            "calibration"
          ]
        },
        "provenance_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "PlanBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_node",
        "source_port",
        "timing"
      ],
      "properties": {
        "source_node": {
          "type": "string",
          "minLength": 1
        },
        "source_port": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "enum": [
            "same_step",
            "previous_step"
          ]
        }
      }
    },
    "PlanNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module_id",
        "module_version",
        "owner_kind",
        "owner_id",
        "phase",
        "parameters",
        "inputs",
        "outputs",
        "initial_outputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "module_id": {
          "type": "string",
          "minLength": 1
        },
        "module_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "owner_kind": {
          "enum": [
            "environment",
            "source",
            "population"
          ]
        },
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "integer",
          "minimum": 0
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/PlanParameter"
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PlanBinding"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "initial_outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "CompiledPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_version",
        "graph_id",
        "execution_semantics",
        "nodes",
        "schedule"
      ],
      "properties": {
        "plan_version": {
          "const": "0.3.0"
        },
        "graph_id": {
          "type": "string",
          "minLength": 1
        },
        "execution_semantics": {
          "const": "spatial-unbiased-v1"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/PlanNode"
          }
        },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schedule_version",
            "read_boundary",
            "commit",
            "prepare_nodes",
            "settlements",
            "signal_nodes",
            "motion_nodes",
            "field_order",
            "motion_policy",
            "degradation_nodes",
            "field_sources",
            "degradation_participants"
          ],
          "properties": {
            "schedule_version": {
              "const": "0.2.0"
            },
            "read_boundary": {
              "const": "step_start"
            },
            "commit": {
              "const": "atomic"
            },
            "prepare_nodes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "signal_nodes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "settlements": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "inventory_node",
                  "participant_nodes"
                ],
                "properties": {
                  "inventory_node": {
                    "type": "string",
                    "minLength": 1
                  },
                  "participant_nodes": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "motion_nodes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "field_order": {
              "const": [
                "contact_degradation",
                "finite_release",
                "stable_diffusion_substeps",
                "shared_uptake"
              ]
            },
            "motion_policy": {
              "const": "synchronous-event-intervals-conservative-block"
            },
            "degradation_nodes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "field_sources": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field_node",
                  "species",
                  "source_nodes",
                  "material_nodes"
                ],
                "properties": {
                  "field_node": {
                    "type": "string",
                    "minLength": 1
                  },
                  "species": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_nodes": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "material_nodes": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "degradation_participants": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "material_nodes",
                "enzyme_nodes"
              ],
              "properties": {
                "material_nodes": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "enzyme_nodes": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "description": "Exact spatial schedule: step-start contact degradation, finite release, stable diffusion substeps, shared uptake, signals, synchronous motion and atomic geometry/inventory commit. Global source, material and enzyme bindings are explicit."
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_version",
        "backend",
        "precision",
        "python_version",
        "numpy_version",
        "platform",
        "source_sha256",
        "rng"
      ],
      "properties": {
        "provenance_version": {
          "const": "0.2.0"
        },
        "backend": {
          "const": "numpy-cpu"
        },
        "precision": {
          "const": "float64"
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "numpy_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "rng": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "seed",
            "used"
          ],
          "properties": {
            "algorithm": {
              "const": "pcg64-sha256-key-v1"
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "used": {
              "type": "boolean"
            }
          }
        }
      },
      "description": "Actual execution seed, source hashes and keyed PCG64 algorithm. used means a nonempty motion group has positive tumble rate."
    },
    "FrameEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "step_index",
        "time_s",
        "grid_revision",
        "frame",
        "object_states"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "step_index": {
          "type": "integer",
          "minimum": 0
        },
        "time_s": {
          "type": "number",
          "minimum": 0
        },
        "grid_revision": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "oneOf": [
            {
              "$ref": "frame.schema.json"
            },
            {
              "$ref": "frame-v0.2.schema.json"
            }
          ]
        },
        "concentrations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit",
              "values_zyx"
            ],
            "properties": {
              "unit": {
                "const": "uM"
              },
              "values_zyx": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "object_states": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "object_type",
              "remaining_molecules"
            ],
            "properties": {
              "object_type": {
                "enum": [
                  "material.degradable_box",
                  "source.attractant"
                ]
              },
              "remaining_molecules": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      },
      "description": "concentrations is required exactly when the frozen output plan requests fields; keys and ZYX shape must match active project fields and domain. object_states always includes every registered finite inventory node, even when include_fields is false."
    },
    "CommonError": {
      "$ref": "task-v0.1.schema.json#/$defs/Error"
    }
  },
  "x-state-transitions": {
    "queued": [
      "running",
      "cancelled",
      "failed",
      "interrupted"
    ],
    "running": [
      "completed",
      "failed",
      "cancelled",
      "interrupted"
    ],
    "completed": [],
    "failed": [],
    "cancelled": [],
    "interrupted": []
  }
}
