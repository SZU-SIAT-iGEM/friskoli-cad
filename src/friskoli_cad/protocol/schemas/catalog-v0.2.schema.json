{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:friskoli:catalog:0.2.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "catalog_version": {
      "const": "0.2.0"
    },
    "module_protocol_versions": {
      "const": [
        "0.1.0"
      ]
    },
    "execution_semantics": {
      "const": "conservative-pts-bulk-v1"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    }
  },
  "required": [
    "catalog_version",
    "module_protocol_versions",
    "execution_semantics",
    "modules",
    "entries",
    "objects"
  ],
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "data",
            "numerical",
            "mechanism",
            "closure"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "devices": {
          "const": [
            "cpu"
          ]
        },
        "world_access": {
          "enum": [
            "legacy_inferred",
            "read_only",
            "transactional"
          ]
        },
        "mathematics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "equations",
                "algorithm",
                "undocumented"
              ]
            },
            "equations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "latex": {
                    "type": "string",
                    "minLength": 1
                  },
                  "symbols": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "latex",
                  "symbols"
                ]
              }
            },
            "algorithm": {
              "type": "string"
            },
            "implementation": {
              "type": "string",
              "minLength": 1
            },
            "verification": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "enum": [
                    "tested",
                    "unreviewed"
                  ]
                },
                "tests": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "status",
                "tests"
              ]
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "kind",
            "equations",
            "algorithm",
            "implementation",
            "verification",
            "assumptions"
          ]
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputs": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/port"
              }
            },
            "outputs": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/port"
              }
            }
          },
          "required": [
            "inputs",
            "outputs"
          ]
        }
      },
      "required": [
        "key",
        "label",
        "category",
        "summary",
        "devices",
        "world_access",
        "mathematics",
        "ports"
      ]
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "enum": [
            "owner.cells",
            "world.grid",
            "owner.source",
            "world",
            "events"
          ]
        },
        "time": {
          "const": "conservative-pts-bulk-v1; timing is declared on each edge"
        },
        "species_parameter": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "shape",
        "quantity",
        "unit",
        "entity",
        "time",
        "species_parameter"
      ]
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "initializer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "type": "string",
              "minLength": 1
            },
            "module": {
              "type": "string",
              "minLength": 1
            },
            "data_modules": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "adapter",
            "module",
            "data_modules"
          ]
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "enum": [
                  "count",
                  "length",
                  "diameter",
                  "seed",
                  "center",
                  "size",
                  "rotation"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "number",
                  "integer",
                  "vector3"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              }
            },
            "required": [
              "path",
              "label",
              "group",
              "type",
              "unit"
            ]
          }
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "description",
        "icon",
        "initializer",
        "properties"
      ]
    }
  }
}
