{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:friskoli:protocol:module:0.1.0",
  "title": "Friskoli module manifest 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "id", "version", "scope", "phase", "scientific_role", "maturity", "inputs", "outputs", "parameters", "state", "initial_outputs"],
  "properties": {
    "protocol_version": {"const": "0.1.0"},
    "id": {"$ref": "#/$defs/moduleId"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "scope": {"enum": ["environment", "source", "population"]},
    "phase": {"type": "integer", "minimum": 0},
    "scientific_role": {"enum": ["mechanism", "closure", "numerical"]},
    "maturity": {"enum": ["reference", "exploratory", "calibrated"]},
    "description": {"type": "string"},
    "inputs": {"$ref": "#/$defs/ports"},
    "outputs": {"$ref": "#/$defs/ports"},
    "parameters": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/parameter"}
    },
    "state": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/state"}
    },
    "initial_outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "moduleId": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "ports": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/port"}
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "quantity", "unit"],
      "properties": {
        "shape": {"enum": ["cell.scalar", "cell.vector", "cell.index", "cell.boolean", "field.scalar", "field.vector", "source.scalar", "global.scalar", "global.vector", "event"]},
        "quantity": {"$ref": "#/$defs/name"},
        "unit": {"type": "string", "minLength": 1},
        "species_parameter": {"$ref": "#/$defs/name"},
        "optional": {"type": "boolean"},
        "description": {"type": "string"}
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["number", "integer", "boolean", "string"]},
        "unit": {"type": "string", "minLength": 1},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "description": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"enum": ["number", "integer"]}}},
          "then": {"required": ["unit"]},
          "else": {"not": {"anyOf": [{"required": ["unit"]}, {"required": ["minimum"]}, {"required": ["maximum"]}]}}
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "unit", "on_division"],
      "properties": {
        "shape": {"enum": ["cell.scalar", "cell.vector", "cell.index", "cell.boolean", "field.scalar", "field.vector", "source.scalar", "global.scalar", "global.vector"]},
        "unit": {"type": "string", "minLength": 1},
        "on_division": {"enum": ["copy", "split", "reset", "not_applicable"]},
        "description": {"type": "string"}
      }
    }
  }
}
